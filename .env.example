# =============================================
# Wardeum — Environment Variables
# =============================================
# Copy this file to .env and fill in the values

# --- Telegram Bot ---
BOT_TOKEN=your_bot_token_from_botfather

# Super-admin Telegram IDs (comma-separated, no spaces)
ADMIN_IDS=123456789,987654321

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/wardeum.db

# --- Mini App ---
# Full HTTPS URL where the Mini App is hosted
WEBAPP_URL=https://your-domain.com/app

# --- Webhook (production) ---
# Leave empty to use polling (development)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PATH=/webhook

# --- Bot server (webhook mode) ---
HOST=0.0.0.0
PORT=8080

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Security ---
# Random secret for HMAC validation of Telegram initData
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_random_secret_string_at_least_32_chars

# --- AI Censor (Google Gemini) ---
# Required for Pro+ plan AI moderation feature
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=

# --- Force Subscription (managed via admin panel, these are defaults) ---
FORCE_SUB_ENABLED=false
FORCE_SUB_CHANNEL=

# --- CORS (API) ---
# Comma-separated allowed origins, or * for all (dev only)
CORS_ORIGINS=*
