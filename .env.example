# =============================================
# Wardeum — Environment Variables (Pure Bot)
# =============================================

# --- Telegram Bot ---
BOT_TOKEN=your_bot_token_here

# Super-admin Telegram IDs (comma-separated, no spaces)
ADMIN_IDS=123456789,987654321

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/wardeum.db

# --- Force Subscription ---
FORCE_SUB_ENABLED=false
FORCE_SUB_CHANNEL=
